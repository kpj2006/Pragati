# Copy to .env and fill in. Never commit .env.
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default: newest stable gemini-X.Y-flash your key can use).
GEMINI_MODEL=
# Optional: require this code in the Agent Mode page before the agent runs (recommended for public deployments).
AGENT_ACCESS_CODE=
